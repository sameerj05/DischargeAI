# DischargeAI backend. Copy to .env and edit. Placeholders only; never commit a real .env.

# Server
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Where the patient app lives; links look like ${PATIENT_APP_URL}/s/<linkId>
PATIENT_APP_URL=http://localhost:5173
# Provider endpoints require header x-provider-key: <PROVIDER_API_KEY>
PROVIDER_API_KEY=dev-provider-key
# DEMO_MODE=true enables POST /admin/clock/advance and POST /admin/purge. Set false in production.
DEMO_MODE=true
# Purge job interval (ms). 0 disables the timer (reads still enforce expiry).
PURGE_INTERVAL_MS=60000

# Config bootstrap from the team secret (AWS Secrets Manager hackhealth/secret). auto = fetch it when AWS
# credentials resolve and fill the empty MYSQL_* / DYNAMO_* values below; env values always win. off = env only.
SECRETS_BOOTSTRAP=auto
AWS_SECRET_ARN=arn:aws:secretsmanager:us-west-2:183815333909:secret:hackhealth/secret-ZWa02Q

# SQL: auto = MariaDB/MySQL when MYSQL_HOST is known (env or secret), else SQLite. sqlite | mysql force one.
# SQL_DRIVER=auto falls back to SQLite when MySQL is unreachable and says so in GET /health; mysql fails hard.
SQL_DRIVER=auto
DATABASE_FILE=data/app.db
# The team's RDS MariaDB instance `patients`. Host/port/user/password/database come from the secret
# (mysql-host, mysql-port, mysql-user, mysql-password, mysql-db); set them here only to override.
# Never put the real password in a file; it is read from Secrets Manager at runtime.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=dischargeai
# Or one URL: DATABASE_URL=mysql://user:pass@host:3306/dischargeai
DATABASE_URL=
# TLS to RDS: AWS connection step 1 bundle (scripts/fetch-rds-bundle.sh); required | off
RDS_CA_BUNDLE=certs/global-bundle.pem
MYSQL_SSL=required

# Document store: auto = DynamoDB when the secret loaded (or DYNAMO_ENDPOINT is set), else the SQL twin; local | dynamo force one
DOC_STORE=auto
# The team's table and its hash key (Secrets Manager keys dynamodb-table / dynamodb-table-pk fill these
# when the secret loads; env wins). One item per link, TTL attribute expiresAt (epoch seconds) on every item.
DYNAMO_TABLE=discharge-summaries
DYNAMO_PK=uid
# DynamoDB Local (docker compose up, or scripts/dynamodb-local.sh): http://localhost:8000. Leave empty for real AWS.
DYNAMO_ENDPOINT=
KEY_VERSION=1

# LLM provider for the simplifier and translator agents: offline | bedrock | anthropic
# offline needs no keys and runs the whole demo and the test suite.
# bedrock is the live provider (Amazon Bedrock Converse). Credentials come from the standard AWS chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN in the shell, a profile, or an instance role).
LLM_PROVIDER=offline
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Direct Anthropic API (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Audio dictation: offline (fixture transcript) | aws (Amazon Transcribe Medical via S3; buckets default to AUDIO_BUCKET)
TRANSCRIBE_PROVIDER=offline
TRANSCRIBE_BUCKET=
TRANSCRIBE_OUTPUT_BUCKET=

# Audio storage (sealed with the per-link key): auto = the team bucket when the secret loaded and HeadBucket
# succeeds, else AUDIO_DIR (purge job deletes at day 30); local | s3 force one. The bucket emraudio-rh already
# has a 30-day lifecycle rule; `npm run ensure-s3-lifecycle` verifies it (and adds one on a bucket without it).
AUDIO_STORE=auto
AUDIO_DIR=data/audio
AUDIO_BUCKET=emraudio-rh

# Email: console (prints the message) | smtp (SMTP_URL) | ses (Amazon SES v2)
EMAIL_TRANSPORT=console
EMAIL_FROM=DischargeAI <noreply@example.test>
SMTP_URL=
# Queue instead of sending inline: none | sqs (scripts/email-worker.ts consumes SQS_QUEUE_URL)
EMAIL_QUEUE=none
SQS_QUEUE_URL=
