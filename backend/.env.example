# DischargeAI backend. Copy to .env and edit. Placeholders only; never commit a real .env.
# The server needs AWS: with credentials in the shell (or an instance role) it reads hackhealth/secret at
# boot for RDS (MariaDB) and DynamoDB, and uses S3, Bedrock and Transcribe. Without credentials it only
# starts when DATABASE_URL (or MYSQL_*) names the database.

# Server
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Where the patient app lives; links look like ${PATIENT_APP_URL}/s/<sumId>
PATIENT_APP_URL=http://localhost:5173
# Provider endpoints (/patients, /ingest, /jobs, /synthesize) require header x-provider-key: <PROVIDER_API_KEY>
PROVIDER_API_KEY=dev-provider-key
# Pin the app clock to a moment (ISO-8601) to watch day 30 arrive; leave empty in production.
DEMO_NOW=
# Purge job interval (ms). 0 disables the timer (reads still enforce expiry; npm run sweep runs it once).
PURGE_INTERVAL_MS=60000
# With DEMO_NOW set the purge refuses DynamoDB and S3 (it would delete recent shared data); yes only on a throwaway account.
DEMO_PURGE_ON_AWS=no
MAX_UPLOAD_BYTES=15728640

# Configuration from AWS Secrets Manager (team secret hackhealth/secret). auto reads it at boot when
# credentials resolve; off never calls AWS. Keys: mysql-host, mysql-port, mysql-user, mysql-password,
# mysql-db, dynamodb-table, dynamodb-table-pk. Any variable set below wins over the secret.
SECRETS_BOOTSTRAP=auto
AWS_SECRET_ARN=arn:aws:secretsmanager:us-west-2:183815333909:secret:hackhealth/secret-ZWa02Q
AWS_REGION=us-west-2
# AWS credentials come from the standard chain (shell env, profile, instance role). Never put them here.

# SQL: activeLinks, jobs, audit log, and the team's patientinfo table (read only). MariaDB on RDS in the team account.
#   DATABASE_URL=mysql://admin:<password>@patients.cleqcmkoulma.us-west-2.rds.amazonaws.com:3306/dischargeai
# Leave DATABASE_URL empty to use MYSQL_* (filled from the secret).
DATABASE_URL=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=dischargeai
MYSQL_POOL_SIZE=5
# AWS connection step 1 downloads this bundle: npm run fetch-rds-bundle
#   (curl -o global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem into backend/certs/)
# A relative path is read from backend/. A missing bundle stops the connection.
RDS_CA_BUNDLE=certs/global-bundle.pem
# The team's patient table in the same database, read only (GET /patients).
PATIENTS_TABLE=patientinfo

# Summary store: the DynamoDB table, one item per summary (uid = sumId, sum-id, raw-text, llm-summary,
# translations), TTL on expiresAt. npm run setup-dynamo creates it when missing.
DYNAMO_TABLE=discharge-summaries
DYNAMO_PK=uid

# PDFs from POST /ingest type pdf. npm run setup-s3 creates the bucket and its 30-day lifecycle rule.
PDF_BUCKET=emrpdf-rh

# Audio clips. The bucket keeps the 30-day lifecycle rule.
AUDIO_BUCKET=emraudio-rh

# Deletion receipts: sql (audit_log table, default) | dynamo (receipt# items in the table)
AUDIT_SINK=sql

# The DischargeAI agent on Amazon Bedrock AgentCore Runtime (AI-Infra branch). It writes llm-summary;
# the sum-id is its session id. Leave AGENT_QUALIFIER empty for the runtime's DEFAULT endpoint.
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:183815333909:runtime/DischargeAIAgent_DischargeAI-y8mQ6FEN5u
AGENT_QUALIFIER=
# One agent run may take this long before the job fails (AgentCore stops a synchronous call at 15 minutes).
AGENT_TIMEOUT_MS=900000

# Dictated audio goes through Amazon Transcribe Medical over the audio bucket.
# Transcribe writes transcripts/<job>.json here; defaults to AUDIO_BUCKET (same 30-day lifecycle)
TRANSCRIBE_OUTPUT_BUCKET=

# Email: console (prints the message) | smtp (SMTP_URL) | ses (Amazon SES v2)
EMAIL_TRANSPORT=console
EMAIL_FROM=DischargeAI <noreply@example.test>
SMTP_URL=
# Queue instead of sending inline: none | sqs (scripts/email-worker.ts consumes SQS_QUEUE_URL)
EMAIL_QUEUE=none
SQS_QUEUE_URL=
